# PostgreSQL. DATABASE_URL may be pooled; DIRECT_URL should be direct for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thm_labtrack?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/thm_labtrack?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Cloudinary credentials are required for screenshot uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional account controls.
ALLOW_STUDENT_SIGNUP="true"
# Comma-separated exact domains, e.g. college.edu,students.college.edu. Empty = no domain restriction.
ALLOWED_EMAIL_DOMAINS=""
# Protect GET /api/cron/deadline-reminders with Authorization: Bearer <secret>.
CRON_SECRET="replace-with-a-long-random-secret"

# Optional manager seeding.
SEED_MANAGER_EMAIL="manager@college.edu"
SEED_MANAGER_PASSWORD="Use-A-Long-Unique-Password-123"
